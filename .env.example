# Nusxa oling: .env — va qiymatlarni o'zgartiring. .env faylini repozitoriyga qo'shmang.

# PostgreSQL
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://nwi:PAROL@localhost:5432/nwi

# API
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Admin panel manzillari, vergul bilan
ALLOWED_ORIGINS=http://localhost:5173
# Ishlab chiqarishda har doim true (HTTPS talab qilinadi)
COOKIE_SECURE=false
# Reverse proxy ortida ishlaganda proksi sakrashlari soni
TRUST_PROXY=0

# 32 baytli kalit, base64. Yaratish: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Sessiya
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Zarur rollar uchun MFA majburiyligi. Ishlab chiqarishda true.
MFA_ENFORCED=true

# Tashkilot vaqt zonasi (ish kuni chegarasi shu bo'yicha hisoblanadi)
ORG_TIMEZONE=Asia/Tashkent

# Kirish urinishlari cheklovi (bir IP, 15 daqiqada)
LOGIN_RATE_LIMIT=20

# Agent konfiguratsiyasini imzolash kaliti (Ed25519 urug'i). Yaratish: openssl rand -base64 32
# Ochiq kalitni olish: npm run agent:pubkey -w @nwi/api
AGENT_CONFIG_SIGNING_KEY=
AGENT_ONLINE_WINDOW_SEC=180
# Shifrlangan fayllar papkasi (zaxira nusxaga kiritilishi kerak)
STORAGE_DIR=storage
SCREENSHOT_RETENTION_DAYS=14
ACTIVITY_MAX_AGE_DAYS=90
