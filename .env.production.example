# Ishlab chiqarish sozlamalari. Nusxa oling: cp .env.production.example .env.production
# .env.production faylini HECH QACHON repozitoriyga qo'shmang.

# Domen (sertifikatdagi nom bilan bir xil bo'lishi kerak)
NWI_DOMAIN=nwi.nordic.uz

# PostgreSQL
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://nwi:PAROL@db:5432/nwi

# API
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# Panel o'zi bilan bir xil domende, shuning uchun o'z domenini yozing:
ALLOWED_ORIGINS=https://nwi.nordic.uz
# Caddy ortida ishlaydi:
COOKIE_SECURE=true
TRUST_PROXY=1

# Shifrlash kaliti. YO'QOLSA ekran tasvirlari va MFA sirlarini ochib bo'lmaydi.
# Bu qiymatni zaxira kalit bilan ALOHIDA, xavfsiz joyda saqlang.
# Yaratish: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Agent konfiguratsiyasini imzolash kaliti. Yaratish: openssl rand -base64 32
AGENT_CONFIG_SIGNING_KEY=

# Sessiya
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
MFA_ENFORCED=true

# Tashkilot vaqt zonasi
ORG_TIMEZONE=Asia/Tashkent
LOGIN_RATE_LIMIT=20

# Fayl ombori (volume shu yo'lga ulanadi)
STORAGE_DIR=/data/storage
SCREENSHOT_RETENTION_DAYS=14
AGENT_ONLINE_WINDOW_SEC=180
ACTIVITY_MAX_AGE_DAYS=90
